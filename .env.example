# ---- LLM ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Search provider ----
# tavily | mock | ddg   (mock & ddg require no key; tavily falls back to mock if no key set)
SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# ---- LangSmith (optional) ----
# Activating tracing only requires LANGCHAIN_TRACING_V2=true and a valid LANGCHAIN_API_KEY.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-agent

# ---- Postgres (checkpointer) ----
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agent:agent@postgres:5432/agent

# ---- Agent tuning ----
MAX_SUB_QUESTIONS=4
MAX_ITERATIONS=2
CONFIDENCE_THRESHOLD=0.7
SEARCH_RESULTS_PER_QUERY=5
FETCH_TOP_N=3
CIRCUIT_BREAKER_FAILURES=3

LOG_LEVEL=INFO
